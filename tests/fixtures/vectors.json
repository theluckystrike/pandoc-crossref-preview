    {
      "name": "Second figure",
      "acceptance": "A1",
      "args": [
        "![A](a.png){#fig:a}\n\n![B](b.png){#fig:b}\n\nSee @fig:b."
      ],
      "expected": {
        "labels": [
          "fig:a=1@1",
          "fig:b=2@3"
        ],
        "references": [
          "Figure 2"
        ],
        "issues": []
      }
    },
    {
      "name": "Two references in one sentence",
      "acceptance": "A1",
      "args": [
        "![A](a.png){#fig:a}\n\nSee @fig:a and @fig:a."
